{
  "name": "samrat-of-bharatavarsha",
  "version": "2.0.0",
  "private": true,
  "description": "Samrat of Bharatavarsha Live Auction & Strategy Event Platform",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:backend": "node backend/server.js",
    "start:frontend": "npm --prefix frontend/nirvana_frontend run dev",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend/nirvana_frontend run dev",
    "build": "npm --prefix frontend/nirvana_frontend run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
